{
    "name": "veltra/veltra-laravel",
    "description": "Enterprise Admin Dashboard UI Suite for Laravel 10, 11, 12 and 13 powered by Tailwind CSS v4 and Vanilla JS",
    "keywords": [
        "laravel",
        "veltra",
        "veltra-ui",
        "dashboard",
        "admin",
        "tailwind-css",
        "tailwindcss-v4",
        "blade-components",
        "dark-mode",
        "tall-stack"
    ],
    "homepage": "https://veltra-ui.stivensespinoza.dev",
    "license": "MIT",
    "authors": [
        {
            "name": "Veltra Ecosystem Team",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/view": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/routing": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.20|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.4|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Veltra\\VeltraLaravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Veltra\\VeltraLaravel\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Veltra\\VeltraLaravel\\VeltraLaravelServiceProvider"
            ],
            "aliases": {
                "Veltra": "Veltra\\VeltraLaravel\\Facades\\Veltra"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
