<{{ layoutTag }}>
    <x-slot name="header">
        <section class="vlt-content-header">
            <div>
                <h1 class="vlt-page-title">{{ __('{{ pageTitle }}') }}</h1>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
                    {{ __('{{ pageSubtitle }}') }}
                </p>
            </div>
            <nav class="vlt-breadcrumb" aria-label="Breadcrumb">
                <ol class="flex items-center gap-2 text-xs">
                    <li><a href="{{ route('dashboard') }}" class="text-slate-500 hover:text-cyan-600 font-medium">{{ __('Home') }}</a></li>
                    <li><span class="text-slate-300 dark:text-slate-600">/</span></li>
                    <li class="active font-bold text-cyan-600">{{ __('{{ pageTitle }}') }}</li>
                </ol>
            </nav>
        </section>
    </x-slot>

    <div class="w-full">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Products Catalog (2 cols) -->
            <div class="lg:col-span-2 space-y-4">
                <div class="vlt-card p-4 border border-slate-200/80 dark:border-slate-800 bg-white dark:bg-slate-900 rounded-2xl shadow-xs">
                    <div class="relative mb-4">
                        <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute left-3 top-2.5 pointer-events-none"></i>
                        <input type="text" placeholder="{{ __('Search catalog products...') }}"
                            class="w-full pl-9 pr-3 py-1.5 text-xs rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 focus:outline-none focus:border-cyan-500 text-slate-800 dark:text-slate-100 placeholder:text-slate-400" />
                    </div>

                    <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
                        <button type="button" class="p-3 text-left rounded-xl border border-slate-100 dark:border-slate-800 hover:border-cyan-500 bg-slate-50/50 dark:bg-slate-800/40 hover:bg-cyan-50/20 dark:hover:bg-cyan-950/20 transition-all cursor-pointer">
                            <span class="text-xs font-bold text-slate-900 dark:text-white block">Standard Coffee</span>
                            <span class="text-xs text-cyan-600 dark:text-cyan-400 font-mono font-bold mt-1 block">$3.50</span>
                        </button>
                        <button type="button" class="p-3 text-left rounded-xl border border-slate-100 dark:border-slate-800 hover:border-cyan-500 bg-slate-50/50 dark:bg-slate-800/40 hover:bg-cyan-50/20 dark:hover:bg-cyan-950/20 transition-all cursor-pointer">
                            <span class="text-xs font-bold text-slate-900 dark:text-white block">Croissant Bakery</span>
                            <span class="text-xs text-cyan-600 dark:text-cyan-400 font-mono font-bold mt-1 block">$4.20</span>
                        </button>
                        <button type="button" class="p-3 text-left rounded-xl border border-slate-100 dark:border-slate-800 hover:border-cyan-500 bg-slate-50/50 dark:bg-slate-800/40 hover:bg-cyan-50/20 dark:hover:bg-cyan-950/20 transition-all cursor-pointer">
                            <span class="text-xs font-bold text-slate-900 dark:text-white block">Avocado Toast</span>
                            <span class="text-xs text-cyan-600 dark:text-cyan-400 font-mono font-bold mt-1 block">$7.80</span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Current Order / Receipt (1 col) -->
            <div class="space-y-4">
                <div class="vlt-card p-5 border border-slate-200/80 dark:border-slate-800 bg-white dark:bg-slate-900 rounded-2xl shadow-xs">
                    <div class="flex items-center justify-between pb-3 border-b border-slate-100 dark:border-slate-800">
                        <h3 class="text-sm font-bold text-slate-900 dark:text-white">{{ __('Current Order') }}</h3>
                        <span class="font-mono text-xs text-cyan-600 font-bold">#ORD-9021</span>
                    </div>

                    <div class="py-4 space-y-3">
                        <div class="flex items-center justify-between text-xs">
                            <span class="text-slate-700 dark:text-slate-300">1x Standard Coffee</span>
                            <span class="font-mono font-bold text-slate-900 dark:text-white">$3.50</span>
                        </div>
                        <div class="flex items-center justify-between text-xs">
                            <span class="text-slate-700 dark:text-slate-300">2x Croissant Bakery</span>
                            <span class="font-mono font-bold text-slate-900 dark:text-white">$8.40</span>
                        </div>
                    </div>

                    <div class="pt-3 border-t border-slate-100 dark:border-slate-800 space-y-2">
                        <div class="flex items-center justify-between text-xs text-slate-500">
                            <span>{{ __('Subtotal') }}</span>
                            <span class="font-mono">$11.90</span>
                        </div>
                        <div class="flex items-center justify-between text-sm font-black text-slate-900 dark:text-white pt-1">
                            <span>{{ __('Total') }}</span>
                            <span class="font-mono text-cyan-600 dark:text-cyan-400">$11.90</span>
                        </div>
                    </div>

                    <button type="button" class="w-full mt-5 py-2.5 px-4 rounded-xl bg-cyan-500 hover:bg-cyan-600 active:bg-cyan-700 text-white font-bold text-xs shadow-xs transition-colors">
                        {{ __('Charge Order') }}
                    </button>
                </div>
            </div>
        </div>
    </div>
</{{ layoutTag }}>
