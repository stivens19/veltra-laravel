<{{ layoutTag }}>
    <x-slot name="header">
        <section class="vlt-content-header">
            <div>
                <h1 class="vlt-page-title">{{ __('{{ pageTitle }}') }}</h1>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
                    {{ __('{{ pageSubtitle }}') }}
                </p>
            </div>
            <nav class="vlt-breadcrumb" aria-label="Breadcrumb">
                <ol class="flex items-center gap-2 text-xs">
                    <li><a href="{{ route('dashboard') }}" class="text-slate-500 hover:text-cyan-600 font-medium">{{ __('Home') }}</a></li>
                    <li><span class="text-slate-300 dark:text-slate-600">/</span></li>
                    <li class="active font-bold text-cyan-600">{{ __('{{ pageTitle }}') }}</li>
                </ol>
            </nav>
        </section>
    </x-slot>

    <div class="w-full">
        <div class="vlt-card border border-slate-200/80 dark:border-slate-800 bg-white dark:bg-slate-900 rounded-2xl shadow-xs overflow-hidden w-full">
            <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 px-6 py-4">
                <div class="flex items-center gap-2.5">
                    <div class="w-8 h-8 rounded-xl bg-cyan-50 dark:bg-cyan-950/40 text-cyan-600 dark:text-cyan-400 flex items-center justify-center shrink-0">
                        <i data-lucide="layers" class="w-4 h-4"></i>
                    </div>
                    <div>
                        <h2 class="text-sm font-bold text-slate-900 dark:text-white">{{ __('{{ pageTitle }} Workspace') }}</h2>
                        <p class="text-[11px] text-slate-500 dark:text-slate-400">{{ __('Blank canvas ready for development') }}</p>
                    </div>
                </div>
                <span class="vlt-pill vlt-pill-cyan text-xs font-semibold">{{ __('Ready') }}</span>
            </div>

            <div class="py-16 px-6 text-center">
                <div class="w-16 h-16 mx-auto rounded-2xl bg-cyan-50 dark:bg-cyan-950/40 text-cyan-600 dark:text-cyan-400 flex items-center justify-center mb-4 ring-1 ring-cyan-500/20 shadow-xs">
                    <i data-lucide="sparkles" class="w-8 h-8"></i>
                </div>
                <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">
                    {{ __('Your canvas is ready') }}
                </h3>
                <p class="text-xs text-slate-500 dark:text-slate-400 max-w-md mx-auto leading-relaxed mb-6">
                    {{ __('Start building your interface here using VeltraUI Blade components, Livewire, or your custom business logic.') }}
                </p>
                <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-slate-50 dark:bg-slate-800/60 text-xs font-mono text-slate-600 dark:text-slate-300 border border-slate-200/80 dark:border-slate-700/60">
                    <span class="w-2 h-2 rounded-full bg-cyan-500"></span>
                    <span>{{ viewName }}</span>
                </div>
            </div>
        </div>
    </div>
</{{ layoutTag }}>
