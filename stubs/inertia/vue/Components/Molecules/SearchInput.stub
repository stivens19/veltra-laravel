<script setup>
defineProps({
    placeholder: {
        type: String,
        default: 'Buscar en menú...',
    },
    modelValue: String,
});

defineEmits(['update:modelValue']);
</script>

<template>
    <div class="relative">
        <svg 
            class="w-4 h-4 text-slate-400 absolute left-3 top-2.5 pointer-events-none" 
            fill="none" 
            stroke="currentColor" 
            viewBox="0 0 24 24"
        >
            <circle cx="11" cy="11" r="8" stroke-width="2" />
            <path stroke-width="2" stroke-linecap="round" d="m21 21-4.3-4.3" />
        </svg>
        <input
            type="text"
            :placeholder="placeholder"
            :value="modelValue"
            @input="$emit('update:modelValue', $event.target.value)"
            class="w-full pl-9 pr-3 py-1.5 text-xs rounded-xl bg-slate-50 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 focus:outline-none focus:border-cyan-500 text-slate-800 dark:text-slate-100 placeholder:text-slate-400"
        />
    </div>
</template>
