<script setup>
import { ref, computed } from 'vue';
import { Link, usePage } from '@inertiajs/vue3';
import BrandLogo from '../Atoms/BrandLogo.vue';
import UserPanel from '../Molecules/UserPanel.vue';
import SearchInput from '../Molecules/SearchInput.vue';
import {
    Gauge,
    LayoutGrid,
    Copy,
    PlayCircle,
    BookOpen,
    Layers,
    FileText,
    Table,
    Calendar,
    Kanban,
    User,
    Users,
    ShieldCheck,
    ChevronRight,
    Circle,
    CircleDot,
    Link2,
    Palette,
    Globe
} from '@lucide/vue';

const iconMap = {
    gauge: Gauge,
    'layout-grid': LayoutGrid,
    copy: Copy,
    'play-circle': PlayCircle,
    'book-open': BookOpen,
    layers: Layers,
    'file-text': FileText,
    table: Table,
    calendar: Calendar,
    trello: Kanban,
    user: User,
    users: Users,
    'shield-check': ShieldCheck,
    'circle-dot': CircleDot,
    circle: Circle,
    'link-2': Link2,
    palette: Palette,
    globe: Globe,
};

const getIcon = (name) => iconMap[name] || Circle;

const props = defineProps({
    user: Object,
});

const page = usePage();
const veltraNav = computed(() => page.props.veltra?.navigation);

const defaultNav = [
    { header: 'MAIN NAVIGATION' },
    {
        title: 'Dashboard',
        icon: 'gauge',
        url: '/dashboard',
    },
    { header: 'SISTEMA & CUENTA' },
    {
        title: 'Perfil & 2FA',
        icon: 'shield-check',
        url: '/settings/profile',
    },
];

const navItems = computed(() => {
    return (Array.isArray(veltraNav.value) && veltraNav.value.length > 0) ? veltraNav.value : defaultNav;
});

const normalizePath = (url) => {
    if (!url || url === '#') return '';
    try {
        const path = new URL(url, 'http://localhost').pathname;
        return ('/' + path.replace(/^\/+|\/+$/g, '')) || '/';
    } catch {
        return ('/' + String(url).replace(/^\/+|\/+$/g, '')) || '/';
    }
};

const isItemActive = (item) => {
    if (!item?.url || item.url === '#') return false;
    const current = normalizePath(page.url);
    const target = normalizePath(item.url);
    if (!target) return false;

    // Exact match
    if (current === target) return true;

    // Settings / Profile family
    if (['/profile', '/settings/profile', '/settings/security', '/settings/appearance', '/settings'].includes(target)) {
        return current.startsWith('/settings') || current.startsWith('/profile');
    }

    // Dashboard root match
    if (target === '/dashboard' || target === '/') {
        return current === '/dashboard' || current === '/';
    }

    // Subpath match
    return current.startsWith(target + '/');
};

const hasActiveChild = (item) => {
    if (!item?.children || !Array.isArray(item.children)) return false;
    return item.children.some(child => isItemActive(child));
};

const openGroups = ref({});
const toggleGroup = (idx) => {
    openGroups.value[idx] = !openGroups.value[idx];
};
</script>

<template>
    <aside class="vlt-sidebar border-r border-slate-200/80 dark:border-slate-800 bg-white/95 dark:bg-slate-900/95 backdrop-blur-md flex flex-col">
        <!-- Sidebar Brand Header -->
        <div class="vlt-sidebar-brand p-4 border-b border-slate-200/60 dark:border-slate-800/60">
            <BrandLogo href="/dashboard" />
        </div>

        <!-- User Panel Molecule -->
        <div class="p-3">
            <UserPanel :user="user" role="Administrator" />
        </div>

        <!-- Sidebar Search Molecule -->
        <div class="vlt-sidebar-search px-3 py-1">
            <SearchInput placeholder="Buscar en menú..." />
        </div>

        <!-- Navigation List -->
        <ul class="vlt-nav px-3 py-2 space-y-1 flex-1 overflow-y-auto">
            <template v-for="(item, idx) in navItems" :key="idx">
                <li v-if="item.header" class="vlt-nav-header text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider px-3 py-2 mt-3 first:mt-0">
                    {{ item.header }}
                </li>

                <!-- Treeview Parent with Children -->
                <li v-else-if="item.children && item.children.length > 0" class="vlt-nav-item">
                    <button
                        type="button"
                        @click="toggleGroup(idx)"
                        :class="[
                            'vlt-nav-link w-full flex items-center justify-between px-3 py-2 rounded-xl text-xs transition-colors cursor-pointer',
                            hasActiveChild(item) || isItemActive(item)
                                ? 'active bg-cyan-500 !text-white font-bold shadow-xs'
                                : 'text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white font-semibold'
                        ]"
                    >
                        <div class="flex items-center gap-2.5 min-w-0">
                            <component :is="getIcon(item.icon)" :class="['w-4 h-4 shrink-0', (hasActiveChild(item) || isItemActive(item)) ? '!text-white' : 'text-slate-500 dark:text-slate-400']" />
                            <span :class="['vlt-nav-text truncate', (hasActiveChild(item) || isItemActive(item)) ? '!text-white font-bold' : '']">{{ item.title }}</span>
                        </div>
                        <ChevronRight :class="['w-3.5 h-3.5 transition-transform duration-200 shrink-0', (hasActiveChild(item) || isItemActive(item)) ? '!text-white' : '', openGroups[idx] ? 'rotate-90' : '']" />
                    </button>
                    <ul v-show="openGroups[idx] ?? true" class="vlt-nav-treeview pl-4 pr-1 py-1.5 space-y-1 mt-1 border-l-2 border-slate-200/60 dark:border-slate-800 ml-4">
                        <li v-for="(child, cIdx) in item.children" :key="cIdx">
                            <Link
                                :href="child.url || '#'"
                                :class="[
                                    'flex items-center gap-2 px-3 py-1.5 rounded-lg text-xs font-medium transition-colors',
                                    isItemActive(child)
                                        ? 'active !text-white !bg-cyan-500 font-bold shadow-xs'
                                        : 'text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white'
                                ]"
                            >
                                <component :is="getIcon(child.icon)" :class="['w-3.5 h-3.5 shrink-0', isItemActive(child) ? '!text-white' : 'text-slate-400']" />
                                <span :class="['truncate', isItemActive(child) ? '!text-white font-bold' : '']">{{ child.title }}</span>
                            </Link>
                        </li>
                    </ul>
                </li>

                <!-- Normal Item -->
                <li v-else class="vlt-nav-item">
                    <Link
                        :href="item.url || '#'"
                        :class="[
                            'vlt-nav-link flex items-center justify-between px-3 py-2 rounded-xl text-xs transition-colors',
                            isItemActive(item)
                                ? 'active bg-cyan-500 !text-white font-bold shadow-xs'
                                : 'text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white font-semibold'
                        ]"
                    >
                        <div class="flex items-center gap-2.5 min-w-0">
                            <component :is="getIcon(item.icon)" :class="['w-4 h-4 shrink-0', isItemActive(item) ? '!text-white' : 'text-slate-500 dark:text-slate-400']" />
                            <span :class="['vlt-nav-text truncate', isItemActive(item) ? '!text-white font-bold' : '']">{{ item.title }}</span>
                        </div>
                        <span v-if="item.badge" :class="['vlt-nav-badge text-[10px] font-bold px-2 py-0.5 rounded-full', item.badge_variant ? `vlt-pill-${item.badge_variant}` : (isItemActive(item) ? 'bg-white/20 !text-white' : 'bg-cyan-100 dark:bg-cyan-950 text-cyan-700 dark:text-cyan-300')]">
                            {{ item.badge }}
                        </span>
                    </Link>
                </li>
            </template>
        </ul>

        <!-- Bottom Status Footer -->
        <div class="vlt-sidebar-status p-3 border-t border-slate-200/80 dark:border-slate-800 mt-auto">
            <div class="flex items-center justify-between text-xs text-slate-500">
                <span class="flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse" />
                    <span class="font-medium text-slate-600 dark:text-slate-400">Online</span>
                </span>
                <span class="font-mono text-[11px] text-slate-400">v1.0.0</span>
            </div>
        </div>
    </aside>
</template>
