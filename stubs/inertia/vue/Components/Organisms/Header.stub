<script setup>
import { ref, computed } from 'vue';
import { Link, usePage, router } from '@inertiajs/vue3';
import ThemeToggle from '../Atoms/ThemeToggle.vue';
import {
    Menu,
    Gauge,
    User,
    Search,
    Bell,
    Maximize,
    LogOut,
    ChevronDown
} from '@lucide/vue';

const props = defineProps({
    user: Object,
});

const emit = defineEmits(['toggleSidebar', 'toggleCollapse']);

const page = usePage();
const userDropdown = ref(false);
const notificationsDropdown = ref(false);

const normalizePath = (url) => {
    if (!url || url === '#') return '';
    try {
        const path = new URL(url, 'http://localhost').pathname;
        return ('/' + path.replace(/^\/+|\/+$/g, '')) || '/';
    } catch {
        return ('/' + String(url).replace(/^\/+|\/+$/g, '')) || '/';
    }
};

const currentPath = computed(() => normalizePath(page.url));
const isDashboard = computed(() => currentPath.value === '/dashboard' || currentPath.value === '/');
const isProfile = computed(() => currentPath.value.startsWith('/settings') || currentPath.value.startsWith('/profile'));

const toggleFullscreen = () => {
    if (!document.fullscreenElement) {
        document.documentElement.requestFullscreen?.().catch(() => {});
    } else {
        document.exitFullscreen?.().catch(() => {});
    }
};

const handleToggle = (e) => {
    e?.preventDefault?.();
    if (typeof window !== 'undefined' && window.innerWidth < 1024) {
        emit('toggleSidebar');
    } else {
        emit('toggleCollapse');
    }
};

const userInitial = computed(() => {
    const name = props.user?.name || page.props.auth?.user?.name || 'U';
    return name.charAt(0).toUpperCase();
});

const userName = computed(() => props.user?.name || page.props.auth?.user?.name || 'Usuario');
const userEmail = computed(() => props.user?.email || page.props.auth?.user?.email || 'admin@example.com');
</script>

<template>
    <header class="vlt-header border-b border-slate-200/80 dark:border-slate-800 bg-white/95 dark:bg-slate-900/95 backdrop-blur-md px-4 py-2.5 flex items-center justify-between">
        <!-- Left Controls: Hamburger, Quick Nav Pills, Search -->
        <div class="flex items-center gap-3">
            <!-- Responsive Toggle Button (Mobile Drawer & Desktop Collapse) -->
            <button
                type="button"
                @click="handleToggle"
                data-vlt-toggle="sidebar"
                aria-label="Colapsar Menú"
                title="Colapsar Menú"
                class="vlt-btn-icon cursor-pointer"
            >
                <Menu class="w-4 h-4" />
            </button>

            <!-- Segmented Quick Nav Pills -->
            <div class="hidden sm:flex items-center gap-1 bg-slate-100 dark:bg-slate-800/80 p-1 rounded-xl border border-slate-200 dark:border-slate-700">
                <Link
                    href="/dashboard"
                    :class="[
                        'px-3 py-1 text-xs rounded-lg font-semibold flex items-center gap-1.5 transition-colors cursor-pointer',
                        isDashboard 
                            ? 'bg-white dark:bg-slate-700 text-slate-900 dark:text-white shadow-xs font-bold' 
                            : 'text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-white/80 dark:hover:bg-slate-700'
                    ]"
                >
                    <Gauge :class="['w-3.5 h-3.5', isDashboard ? 'text-cyan-500' : 'text-slate-400']" />
                    <span>Dashboard</span>
                </Link>
                <Link
                    href="/settings/profile"
                    :class="[
                        'px-3 py-1 text-xs rounded-lg font-semibold flex items-center gap-1.5 transition-colors cursor-pointer',
                        isProfile 
                            ? 'bg-white dark:bg-slate-700 text-slate-900 dark:text-white shadow-xs font-bold' 
                            : 'text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-white/80 dark:hover:bg-slate-700'
                    ]"
                >
                    <User :class="['w-3.5 h-3.5', isProfile ? 'text-cyan-500' : 'text-slate-400']" />
                    <span>Perfil</span>
                </Link>
            </div>

            <!-- Search Button -->
            <button
                type="button"
                title="Buscar (Ctrl+K)"
                class="vlt-btn-icon cursor-pointer"
            >
                <Search class="w-4 h-4" />
            </button>
        </div>

        <!-- Right Controls: Notifications, Fullscreen, Theme, User Profile -->
        <div class="flex items-center gap-2 sm:gap-2.5">
            <!-- Notifications Bell with Amber Dot -->
            <div class="relative">
                <button
                    type="button"
                    @click="notificationsDropdown = !notificationsDropdown"
                    title="Notificaciones"
                    class="vlt-btn-icon relative cursor-pointer"
                >
                    <Bell class="w-4 h-4" />
                    <span class="absolute top-1.5 right-1.5 w-2 h-2 rounded-full bg-amber-400 ring-2 ring-white dark:ring-slate-900"></span>
                </button>

                <div
                    v-if="notificationsDropdown"
                    class="absolute right-0 mt-2 w-72 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-2xl py-3 z-50 animate-in fade-in zoom-in-95 duration-100"
                >
                    <div class="px-4 pb-2 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between">
                        <span class="text-xs font-bold text-slate-900 dark:text-white">Notificaciones</span>
                        <span class="text-[10px] font-semibold text-cyan-600 dark:text-cyan-400 bg-cyan-500/10 px-2 py-0.5 rounded-full">1 Nueva</span>
                    </div>
                    <div class="px-4 py-3 text-xs text-slate-600 dark:text-slate-300">
                        <p class="font-bold text-slate-900 dark:text-white">Bienvenido a VeltraUI</p>
                        <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">El sistema base está configurado y listo para desarrollo.</p>
                    </div>
                </div>
            </div>

            <!-- Fullscreen Toggle -->
            <button
                type="button"
                @click="toggleFullscreen"
                title="Pantalla Completa"
                class="vlt-btn-icon hidden sm:inline-flex cursor-pointer"
            >
                <Maximize class="w-4 h-4" />
            </button>

            <!-- Theme Toggle Atom -->
            <ThemeToggle />

            <!-- User Profile Pill Dropdown -->
            <div class="relative ml-1">
                <button
                    type="button"
                    @click="userDropdown = !userDropdown"
                    class="flex items-center gap-2 p-1 pl-1.5 pr-2 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/80 dark:border-slate-700/60 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors cursor-pointer"
                >
                    <div class="w-6 h-6 rounded-lg bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 font-bold text-[11px] flex items-center justify-center shrink-0">
                        {{ userInitial }}
                    </div>
                    <div class="hidden md:flex flex-col text-left">
                        <span class="text-xs font-bold text-slate-800 dark:text-slate-200 leading-tight max-w-[120px] truncate">
                            {{ userName }}
                        </span>
                        <span class="text-[9px] font-semibold text-slate-400 leading-none">
                            Administrator
                        </span>
                    </div>
                    <ChevronDown class="w-3 h-3 text-slate-400" />
                </button>

                <div
                    v-if="userDropdown"
                    class="absolute right-0 mt-2 w-56 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-2xl py-2 z-50 animate-in fade-in zoom-in-95 duration-100"
                >
                    <div class="px-4 py-2 border-b border-slate-100 dark:border-slate-800">
                        <p class="text-xs font-bold text-slate-900 dark:text-white truncate">{{ userName }}</p>
                        <p class="text-[10px] text-slate-500 dark:text-slate-400 truncate">{{ userEmail }}</p>
                    </div>
                    <div class="py-1">
                        <Link
                            href="/settings/profile"
                            class="flex items-center gap-2 px-4 py-2 text-xs text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors"
                        >
                            <User class="w-3.5 h-3.5 text-cyan-500" />
                            <span>Perfil &amp; 2FA</span>
                        </Link>
                    </div>
                    <div class="pt-1 border-t border-slate-100 dark:border-slate-800">
                        <button
                            type="button"
                            @click="router.post('/logout')"
                            class="w-full flex items-center gap-2 px-4 py-2 text-xs text-rose-600 dark:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-950/20 transition-colors text-left font-medium cursor-pointer"
                        >
                            <LogOut class="w-3.5 h-3.5" />
                            <span>Cerrar Sesión</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </header>
</template>
