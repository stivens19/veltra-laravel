<script lang="ts">
    import { page, Link } from '@inertiajs/svelte';
    import { User, Shield, Sparkles } from '@lucide/svelte';

    let { children }: { children?: any } = $props();

    let user = $derived((page.props as any)?.auth?.user || { name: 'Usuario', email: 'user@example.com' });

    let initials = $derived(
        user.name
            ? user.name
                  .split(' ')
                  .map((n: string) => n[0])
                  .slice(0, 2)
                  .join('')
                  .toUpperCase()
            : 'US'
    );

    let isProfile = $derived(page.url.startsWith('/settings/profile'));
    let isSecurity = $derived(page.url.startsWith('/settings/security'));
    let isAppearance = $derived(page.url.startsWith('/settings/appearance'));
</script>

<div class="space-y-6 max-w-6xl">
    <!-- Breadcrumb & Header -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
        <div>
            <div class="flex items-center gap-2 mb-1">
                <h1 class="text-2xl font-black text-slate-900 dark:text-white tracking-tight">
                    Ajustes
                </h1>
                <span class="vlt-pill vlt-pill-cyan text-xs font-semibold px-2.5 py-0.5 rounded-full bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 border border-cyan-500/20">
                    Cuenta &amp; Seguridad
                </span>
            </div>
            <p class="text-xs text-slate-500 dark:text-slate-400">
                Gestiona tu información de perfil, configuración de seguridad, autenticación en dos factores y apariencia.
            </p>
        </div>
        <nav class="vlt-breadcrumb" aria-label="Breadcrumb">
            <ol class="flex items-center gap-2 text-xs">
                <li>
                    <Link href="/dashboard" class="text-slate-500 hover:text-cyan-600 font-medium">
                        Inicio
                    </Link>
                </li>
                <li class="text-slate-400">/</li>
                <li class="text-cyan-600 dark:text-cyan-400 font-bold">
                    Ajustes
                </li>
            </ol>
        </nav>
    </div>

    <!-- Hero Card VeltraUI (Banner Resumen de Usuario) -->
    <div class="vlt-card p-5 border border-slate-200/80 dark:border-slate-800 bg-white dark:bg-slate-900 rounded-2xl shadow-xs">
        <div class="flex flex-col sm:flex-row items-center sm:items-start justify-between gap-4">
            <div class="flex flex-col sm:flex-row items-center gap-3.5 text-center sm:text-left">
                <div class="relative shrink-0">
                    <div class="w-14 h-14 rounded-2xl bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 font-black flex items-center justify-center text-lg ring-2 ring-cyan-500/30">
                        {initials}
                    </div>
                    <span
                        class="absolute -bottom-0.5 -right-0.5 w-3.5 h-3.5 bg-emerald-500 border-2 border-white dark:border-slate-900 rounded-full"
                        title="Usuario activo"
                    ></span>
                </div>
                <div>
                    <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2">
                        <h2 class="text-base font-black text-slate-900 dark:text-white">
                            {user.name}
                        </h2>
                        <span class="vlt-pill vlt-pill-emerald text-[11px] font-bold py-0.5 px-2 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
                            Activo
                        </span>
                    </div>
                    <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                        {user.email}
                    </p>
                    <span class="inline-block mt-1 text-[10px] font-bold text-cyan-600 dark:text-cyan-400 uppercase tracking-wider font-mono">
                        Cuenta Verificada en VeltraUI
                    </span>
                </div>
            </div>

            <div class="flex items-center gap-2">
                <Link
                    href="/settings/security"
                    class="px-3.5 py-1.5 text-xs font-bold rounded-xl transition-all flex items-center gap-1.5 {isSecurity
                        ? 'bg-cyan-500 text-white shadow-md shadow-cyan-500/20'
                        : 'bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700'}"
                >
                    <Shield class="w-3.5 h-3.5" />
                    <span>Seguridad &amp; 2FA</span>
                </Link>
            </div>
        </div>
    </div>

    <!-- 2-Column Grid Layout: Sidebar Navigation + Main Content -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-start">
        <!-- Sub-Navigation Menu Lateral de Settings (col-span-3) -->
        <div class="md:col-span-3">
            <div class="vlt-card p-3 border border-slate-200/80 dark:border-slate-800 bg-white dark:bg-slate-900 rounded-2xl shadow-xs">
                <div class="px-3 py-2 text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider border-b border-slate-100 dark:border-slate-800 mb-2">
                    Ajustes de Cuenta
                </div>
                <nav class="space-y-1">
                    <Link
                        href="/settings/profile"
                        class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs font-bold transition-all {isProfile
                            ? 'bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 border border-cyan-500/20 shadow-xs'
                            : 'text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800/60 hover:text-slate-900 dark:hover:text-white'}"
                    >
                        <User class="w-4 h-4 {isProfile ? 'text-cyan-500' : 'text-slate-400'}" />
                        <span>Perfil</span>
                    </Link>

                    <Link
                        href="/settings/security"
                        class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs font-bold transition-all {isSecurity
                            ? 'bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 border border-cyan-500/20 shadow-xs'
                            : 'text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800/60 hover:text-slate-900 dark:hover:text-white'}"
                    >
                        <Shield class="w-4 h-4 {isSecurity ? 'text-cyan-500' : 'text-slate-400'}" />
                        <span>Seguridad &amp; 2FA</span>
                    </Link>

                    <Link
                        href="/settings/appearance"
                        class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs font-bold transition-all {isAppearance
                            ? 'bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 border border-cyan-500/20 shadow-xs'
                            : 'text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800/60 hover:text-slate-900 dark:hover:text-white'}"
                    >
                        <Sparkles class="w-4 h-4 {isAppearance ? 'text-cyan-500' : 'text-slate-400'}" />
                        <span>Apariencia</span>
                    </Link>
                </nav>
            </div>
        </div>

        <!-- Panel de Contenido Principal (col-span-9) -->
        <div class="md:col-span-9 space-y-6">
            {@render children?.()}
        </div>
    </div>
</div>
