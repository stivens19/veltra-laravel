<script lang="ts">
    import { page, useForm } from '@inertiajs/svelte';
    import { User, Mail, Save, Check, AlertTriangle, Trash2 } from '@lucide/svelte';

    interface Props {
        mustVerifyEmail?: boolean;
        status?: string;
    }

    let { mustVerifyEmail = false, status = '' }: Props = $props();

    let user = $derived((page.props as any)?.auth?.user || { name: 'Usuario', email: 'user@example.com' });

    // 1. Profile Information Form
    let profileForm = useForm({
        name: user.name || '',
        email: user.email || '',
    });

    function updateProfile(e: Event) {
        e.preventDefault();
        profileForm.patch('/settings/profile', {
            preserveScroll: true,
        });
    }

    // 2. Delete Account Dialog State
    let confirmingUserDeletion = $state(false);
    let deletePasswordInput: HTMLInputElement | null = $state(null);

    let deleteForm = useForm({
        password: '',
    });

    function confirmDelete() {
        confirmingUserDeletion = true;
        setTimeout(() => deletePasswordInput?.focus(), 100);
    }

    function closeModal() {
        confirmingUserDeletion = false;
        deleteForm.clearErrors();
        deleteForm.reset();
    }

    function deleteUser(e: Event) {
        e.preventDefault();
        deleteForm.delete('/settings/profile', {
            preserveScroll: true,
            onSuccess: () => closeModal(),
            onError: () => deletePasswordInput?.focus(),
            onFinish: () => deleteForm.reset(),
        });
    }
</script>

<svelte:head>
    <title>Perfil</title>
</svelte:head>

<div class="space-y-6">
    <!-- 1. Información Personal -->
    <div id="profile" class="vlt-card border border-slate-200/80 dark:border-slate-800 bg-white dark:bg-slate-900 rounded-2xl p-6 shadow-xs">
        <div class="flex items-center justify-between pb-4 border-b border-slate-100 dark:border-slate-800 mb-5">
            <div>
                <h3 class="text-sm font-bold text-slate-900 dark:text-white flex items-center gap-2">
                    <User class="w-4 h-4 text-cyan-500" />
                    Información Personal
                </h3>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                    Actualiza el nombre completo y la dirección de correo de tu cuenta.
                </p>
            </div>
            {#if status === 'profile-updated'}
                <span class="vlt-pill vlt-pill-emerald text-xs font-semibold py-1 px-3 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 flex items-center gap-1">
                    <Check class="w-3.5 h-3.5" />
                    Perfil Guardado
                </span>
            {/if}
        </div>

        <form onsubmit={updateProfile} class="space-y-4 max-w-xl">
            <div>
                <label for="name" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">
                    Nombre Completo <span class="text-rose-500">*</span>
                </label>
                <div class="relative">
                    <User class="w-4 h-4 text-slate-400 absolute left-3.5 top-2.5 pointer-events-none" />
                    <input
                        id="name"
                        type="text"
                        bind:value={profileForm.name}
                        required
                        autocomplete="name"
                        class="w-full pl-10 pr-3 py-2 text-xs rounded-xl bg-slate-50 dark:bg-slate-800 border {profileForm.errors.name ? 'border-rose-500' : 'border-slate-200 dark:border-slate-700'} focus:outline-none focus:border-cyan-500 text-slate-800 dark:text-slate-100 placeholder:text-slate-400 transition-colors"
                    />
                </div>
                {#if profileForm.errors.name}
                    <p class="text-[11px] font-semibold text-rose-500 mt-1">{profileForm.errors.name}</p>
                {/if}
            </div>

            <div>
                <label for="email" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">
                    Correo Electrónico <span class="text-rose-500">*</span>
                </label>
                <div class="relative">
                    <Mail class="w-4 h-4 text-slate-400 absolute left-3.5 top-2.5 pointer-events-none" />
                    <input
                        id="email"
                        type="email"
                        bind:value={profileForm.email}
                        required
                        autocomplete="username"
                        class="w-full pl-10 pr-3 py-2 text-xs rounded-xl bg-slate-50 dark:bg-slate-800 border {profileForm.errors.email ? 'border-rose-500' : 'border-slate-200 dark:border-slate-700'} focus:outline-none focus:border-cyan-500 text-slate-800 dark:text-slate-100 placeholder:text-slate-400 transition-colors"
                    />
                </div>
                {#if profileForm.errors.email}
                    <p class="text-[11px] font-semibold text-rose-500 mt-1">{profileForm.errors.email}</p>
                {/if}
            </div>

            <div class="pt-2">
                <button
                    type="submit"
                    disabled={profileForm.processing}
                    class="px-4 py-2 text-xs font-bold rounded-xl bg-cyan-500 hover:bg-cyan-600 text-white transition-all shadow-md shadow-cyan-500/20 disabled:opacity-50 flex items-center gap-1.5 cursor-pointer"
                >
                    <Save class="w-3.5 h-3.5" />
                    <span>{profileForm.processing ? 'Guardando...' : 'Guardar Cambios'}</span>
                </button>
            </div>
        </form>
    </div>

    <!-- 2. Eliminar Cuenta -->
    <div id="danger-zone" class="vlt-card border border-slate-200/80 dark:border-slate-800 bg-white dark:bg-slate-900 rounded-2xl p-6 shadow-xs">
        <div class="flex items-center justify-between pb-4 border-b border-slate-100 dark:border-slate-800 mb-5">
            <div>
                <h3 class="text-sm font-bold text-rose-600 dark:text-rose-400 flex items-center gap-2">
                    <Trash2 class="w-4 h-4 text-rose-500" />
                    Eliminar Cuenta
                </h3>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                    Una vez que tu cuenta sea eliminada, todos sus recursos y datos serán borrados permanentemente.
                </p>
            </div>
        </div>

        <div class="space-y-4 max-w-xl">
            <div class="p-4 rounded-xl bg-rose-50/50 dark:bg-rose-950/20 border border-rose-200/60 dark:border-rose-900/40 text-rose-800 dark:text-rose-200 text-xs">
                <div class="flex items-center gap-2 font-bold mb-1">
                    <AlertTriangle class="w-4 h-4 text-rose-500" />
                    <span>Advertencia Crítica</span>
                </div>
                Antes de eliminar tu cuenta, descarga cualquier dato o información relevante que desees conservar.
            </div>

            <button
                type="button"
                onclick={confirmDelete}
                class="px-4 py-2 text-xs font-bold rounded-xl bg-rose-600 hover:bg-rose-700 text-white transition-colors cursor-pointer flex items-center gap-1.5"
            >
                <Trash2 class="w-3.5 h-3.5" />
                <span>Eliminar Cuenta Definitivamente</span>
            </button>
        </div>
    </div>
</div>

<!-- Modal de Confirmación de Eliminación de Cuenta -->
{#if confirmingUserDeletion}
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-xs">
        <div class="vlt-card border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 rounded-2xl p-6 max-w-md w-full shadow-2xl space-y-4">
            <div class="flex items-center gap-3 text-rose-600 dark:text-rose-400">
                <div class="w-10 h-10 rounded-xl bg-rose-100 dark:bg-rose-950/50 flex items-center justify-center">
                    <AlertTriangle class="w-5 h-5" />
                </div>
                <div>
                    <h4 class="text-sm font-bold text-slate-900 dark:text-white">¿Confirmas la eliminación?</h4>
                    <p class="text-[11px] text-slate-500 dark:text-slate-400">Esta acción es irreversible.</p>
                </div>
            </div>

            <p class="text-xs text-slate-600 dark:text-slate-300">
                Por favor ingresa tu contraseña para confirmar que deseas eliminar tu cuenta permanentemente.
            </p>

            <form onsubmit={deleteUser} class="space-y-4">
                <div>
                    <input
                        bind:this={deletePasswordInput}
                        type="password"
                        bind:value={deleteForm.password}
                        placeholder="Ingresa tu contraseña"
                        class="w-full px-3 py-2 text-xs rounded-xl bg-slate-50 dark:bg-slate-800 border {deleteForm.errors.password ? 'border-rose-500' : 'border-slate-200 dark:border-slate-700'} focus:outline-none focus:border-rose-500 text-slate-800 dark:text-slate-100 transition-colors"
                    />
                    {#if deleteForm.errors.password}
                        <p class="text-[11px] font-semibold text-rose-500 mt-1">{deleteForm.errors.password}</p>
                    {/if}
                </div>

                <div class="flex items-center justify-end gap-2 pt-2">
                    <button
                        type="button"
                        onclick={closeModal}
                        class="px-3.5 py-1.5 text-xs font-semibold rounded-xl text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors cursor-pointer"
                    >
                        Cancelar
                    </button>
                    <button
                        type="submit"
                        disabled={deleteForm.processing}
                        class="px-4 py-1.5 text-xs font-bold rounded-xl bg-rose-600 hover:bg-rose-700 text-white transition-colors disabled:opacity-50 cursor-pointer"
                    >
                        {deleteForm.processing ? 'Eliminando...' : 'Sí, eliminar'}
                    </button>
                </div>
            </form>
        </div>
    </div>
{/if}
