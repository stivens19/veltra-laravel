<script>
    export let variant = 'cyan';
    export let dot = false;

    const variantClasses = {
        cyan: 'vlt-pill-cyan',
        emerald: 'vlt-pill-emerald',
        amber: 'vlt-pill-amber',
        rose: 'vlt-pill-rose',
        slate: 'bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300 border-slate-200 dark:border-slate-700',
    };
</script>

<span class="vlt-pill {variantClasses[variant] || variantClasses.cyan} text-[11px] font-bold py-0.5 px-2.5 inline-flex items-center gap-1.5">
    {#if dot}
        <span class="pill-dot" />
    {/if}
    <slot />
</span>
