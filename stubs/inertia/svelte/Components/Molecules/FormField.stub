<script>
    import Input from '../Atoms/Input.svelte';

    export let label = '';
    export let error = '';
    export let required = false;
    export let id = '';
    export let value = '';
</script>

<div class="space-y-1.5">
    {#if label}
        <label for={id} class="block text-xs font-bold text-slate-700 dark:text-slate-300">
            {label} {#if required}<span class="text-rose-500">*</span>{/if}
        </label>
    {/if}
    <Input {id} bind:value hasError={!!error} {...$$restProps} />
    {#if error}
        <p class="text-[11px] font-semibold text-rose-500 mt-1">{error}</p>
    {/if}
</div>
