import React, { useState, useEffect } from 'react';
import { usePage } from '@inertiajs/react';
import Sidebar from '@/components/Organisms/Sidebar';
import Header from '@/components/Organisms/Header';

export default function AppLayout({ header, children }) {
    const { auth } = usePage().props;
    const user = auth?.user || { name: 'Usuario', email: 'user@example.com' };
    const [sidebarOpen, setSidebarOpen] = useState(false);
    const [sidebarCollapsed, setSidebarCollapsed] = useState(() => {
        if (typeof window !== 'undefined') {
            try {
                return localStorage.getItem('veltra-sidebar-collapsed') === 'true';
            } catch (e) {
                return false;
            }
        }
        return false;
    });

    const toggleSidebarCollapse = () => {
        setSidebarCollapsed(prev => {
            const next = !prev;
            try {
                localStorage.setItem('veltra-sidebar-collapsed', String(next));
                if (next) {
                    document.body.classList.add('vlt-sidebar-collapsed');
                } else {
                    document.body.classList.remove('vlt-sidebar-collapsed');
                }
            } catch (e) {}
            return next;
        });
    };

    const toggleSidebarMobile = () => {
        setSidebarOpen(prev => !prev);
    };

    useEffect(() => {
        const handleResize = () => {
            if (window.innerWidth >= 1024 && sidebarOpen) {
                setSidebarOpen(false);
            }
        };
        window.addEventListener('resize', handleResize);
        return () => window.removeEventListener('resize', handleResize);
    }, [sidebarOpen]);

    useEffect(() => {
        if (sidebarCollapsed) {
            document.body.classList.add('vlt-sidebar-collapsed');
        } else {
            document.body.classList.remove('vlt-sidebar-collapsed');
        }
    }, [sidebarCollapsed]);

    return (
        <div className={`vlt-body ${sidebarCollapsed ? 'vlt-sidebar-collapsed' : ''} min-h-screen bg-slate-50 dark:bg-[#060913] text-slate-800 dark:text-slate-100`}>
            <div className={`vlt-wrapper ${sidebarCollapsed ? 'vlt-sidebar-collapsed' : ''} ${sidebarOpen ? 'vlt-sidebar-mobile-open' : ''} min-h-screen`}>
                {/* Mobile Backdrop */}
                <div 
                    className="vlt-backdrop" 
                    onClick={() => setSidebarOpen(false)}
                    data-vlt-toggle="sidebar"
                />

                {/* Sidebar Organism */}
                <Sidebar user={user} />

                {/* Main Content Area */}
                <div className="vlt-main flex-1 flex flex-col min-w-0 min-h-screen">
                    {/* Header Organism */}
                    <Header 
                        user={user}
                        onToggleSidebar={toggleSidebarMobile}
                        onToggleCollapse={toggleSidebarCollapse}
                    />

                    {/* Content Header if provided */}
                    {header && (
                        <div className="px-6 py-4 border-b border-slate-200/60 dark:border-slate-800/60 bg-white/50 dark:bg-slate-900/50">
                            {header}
                        </div>
                    )}

                    {/* Page Content */}
                    <main className="p-6 flex-1 flex flex-col">
                        {children}
                    </main>

                    {/* Global Footer */}
                    <footer className="px-6 py-4 text-xs text-slate-400 border-t border-slate-200/60 dark:border-slate-800/60 text-center sm:text-left mt-auto flex items-center gap-2">
                        <span>&copy; {new Date().getFullYear()} VeltraUI. Todos los derechos reservados.</span>
                        <span className="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                        <span className="text-slate-500 font-mono text-[11px]">VeltraLaravel v1.0.0</span>
                    </footer>
                </div>
            </div>
        </div>
    );
}
