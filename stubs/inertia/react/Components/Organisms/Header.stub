import React, { useState } from 'react';
import { Link, usePage, router } from '@inertiajs/react';
import ThemeToggle from '../Atoms/ThemeToggle';
import Avatar from '../Atoms/Avatar';
import {
    Menu,
    Gauge,
    User,
    Search,
    Bell,
    Maximize,
    LogOut,
    ChevronDown
} from 'lucide-react';

export default function Header({ 
    user, 
    onToggleSidebar, 
    onToggleCollapse, 
    className = '' 
}: { 
    user: any; 
    onToggleSidebar?: () => void; 
    onToggleCollapse?: () => void; 
    className?: string; 
}) {
    const { url } = usePage();
    const [userDropdown, setUserDropdown] = useState(false);
    const [notificationsDropdown, setNotificationsDropdown] = useState(false);

    const currentPath = (() => {
        if (!url) return '';
        try {
            const p = new URL(url, 'http://localhost').pathname;
            return ('/' + p.replace(/^\/+|\/+$/g, '')) || '/';
        } catch {
            return ('/' + String(url).replace(/^\/+|\/+$/g, '')) || '/';
        }
    })();

    const isDashboard = currentPath === '/dashboard' || currentPath === '/';
    const isProfile = currentPath.startsWith('/settings') || currentPath.startsWith('/profile');

    const toggleFullscreen = () => {
        if (!document.fullscreenElement) {
            document.documentElement.requestFullscreen?.().catch(() => {});
        } else {
            document.exitFullscreen?.().catch(() => {});
        }
    };

    const handleToggle = (e: React.MouseEvent) => {
        e.preventDefault();
        if (typeof window !== 'undefined' && window.innerWidth < 1024) {
            onToggleSidebar ? onToggleSidebar() : onToggleCollapse?.();
        } else {
            onToggleCollapse ? onToggleCollapse() : onToggleSidebar?.();
        }
    };

    return (
        <header className={`vlt-header border-b border-slate-200/80 dark:border-slate-800 bg-white/95 dark:bg-slate-900/95 backdrop-blur-md px-4 py-2.5 flex items-center justify-between ${className}`}>
            {/* Left Controls: Hamburger, Quick Nav Pills, Search */}
            <div className="flex items-center gap-3">
                {/* Responsive Sidebar Toggle Button (Mobile Drawer & Desktop Collapse) */}
                <button
                    type="button"
                    onClick={handleToggle}
                    data-vlt-toggle="sidebar"
                    aria-label="Colapsar Menú"
                    title="Colapsar Menú"
                    className="p-2 rounded-xl text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors cursor-pointer"
                >
                    <Menu className="w-4 h-4" />
                </button>

                {/* Segmented Quick Nav Pills */}
                <div className="hidden sm:flex items-center gap-1 bg-slate-100 dark:bg-slate-800/80 p-1 rounded-xl border border-slate-200 dark:border-slate-700">
                    <Link
                        href="/dashboard"
                        className={`px-3 py-1 text-xs rounded-lg font-semibold flex items-center gap-1.5 transition-colors cursor-pointer ${
                            isDashboard
                                ? 'bg-white dark:bg-slate-700 text-slate-900 dark:text-white shadow-xs font-bold'
                                : 'text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-white/80 dark:hover:bg-slate-700'
                        }`}
                    >
                        <Gauge className={`w-3.5 h-3.5 ${isDashboard ? 'text-cyan-500' : 'text-slate-400'}`} />
                        <span>Dashboard</span>
                    </Link>
                    <Link
                        href="/settings/profile"
                        className={`px-3 py-1 text-xs rounded-lg font-semibold flex items-center gap-1.5 transition-colors cursor-pointer ${
                            isProfile
                                ? 'bg-white dark:bg-slate-700 text-slate-900 dark:text-white shadow-xs font-bold'
                                : 'text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-white/80 dark:hover:bg-slate-700'
                        }`}
                    >
                        <User className={`w-3.5 h-3.5 ${isProfile ? 'text-cyan-500' : 'text-slate-400'}`} />
                        <span>Perfil</span>
                    </Link>
                </div>

                {/* Search Button */}
                <button
                    type="button"
                    title="Buscar (Ctrl+K)"
                    className="p-2 rounded-xl text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors cursor-pointer"
                >
                    <Search className="w-4 h-4" />
                </button>
            </div>

            {/* Right Controls: Notifications, Fullscreen, Theme, User Profile */}
            <div className="flex items-center gap-1.5 ml-auto">
                {/* Notifications Dropdown */}
                <div className="relative">
                    <button
                        type="button"
                        onClick={() => { setNotificationsDropdown(!notificationsDropdown); setUserDropdown(false); }}
                        className="p-2 rounded-xl text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors relative cursor-pointer"
                        title="Notificaciones"
                    >
                        <Bell className="w-4 h-4" />
                        <span className="absolute top-1.5 right-1.5 w-2 h-2 bg-amber-500 rounded-full"></span>
                    </button>
                    {notificationsDropdown && (
                        <div className="absolute right-0 mt-2 w-72 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xl py-2 z-50">
                            <div className="px-4 py-2 border-b border-slate-100 dark:border-slate-800">
                                <span className="font-bold text-xs text-slate-800 dark:text-slate-100">Notificaciones</span>
                            </div>
                            <div className="px-4 py-3 text-xs text-slate-500 dark:text-slate-400">
                                No tienes notificaciones pendientes.
                            </div>
                        </div>
                    )}
                </div>

                {/* Fullscreen Button */}
                <button
                    type="button"
                    onClick={toggleFullscreen}
                    title="Pantalla Completa"
                    className="hidden sm:inline-flex p-2 rounded-xl text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors cursor-pointer"
                >
                    <Maximize className="w-4 h-4" />
                </button>

                {/* Theme Toggle Atom */}
                <ThemeToggle />

                {/* User Menu Button & Dropdown */}
                <div className="relative ml-1">
                    <button
                        type="button"
                        onClick={() => { setUserDropdown(!userDropdown); setNotificationsDropdown(false); }}
                        className="flex items-center gap-2 p-1 pl-1.5 pr-2.5 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors cursor-pointer"
                    >
                        <div className="w-7 h-7 rounded-full bg-cyan-500/20 text-cyan-600 dark:text-cyan-400 font-bold flex items-center justify-center text-xs ring-2 ring-cyan-500/40">
                            {user?.name ? user.name.charAt(0).toUpperCase() : 'U'}
                        </div>
                        <div className="hidden md:block text-left text-xs leading-tight">
                            <span className="font-bold text-slate-800 dark:text-slate-100 block truncate max-w-[120px]">
                                {user?.name || 'Usuario'}
                            </span>
                            <span className="text-[10px] text-slate-500 dark:text-slate-400">
                                Administrator
                            </span>
                        </div>
                        <ChevronDown className="w-3.5 h-3.5 text-slate-400 ml-0.5" />
                    </button>

                    {userDropdown && (
                        <div className="absolute right-0 mt-2 w-56 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xl py-1 z-50">
                            <div className="px-4 py-3 border-b border-slate-100 dark:border-slate-800">
                                <p className="text-[10px] text-slate-500 dark:text-slate-400">Conectado como</p>
                                <p className="text-xs font-bold text-slate-800 dark:text-slate-100 truncate">{user?.email || 'admin@example.com'}</p>
                            </div>
                            <Link 
                                href="/settings/profile" 
                                className="flex items-center gap-2 px-4 py-2 text-xs text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800"
                            >
                                <User className="w-4 h-4 text-slate-400" />
                                <span>Perfil &amp; Seguridad</span>
                            </Link>
                            <div className="border-t border-slate-100 dark:border-slate-800 my-1"></div>
                            <button
                                type="button"
                                onClick={() => router.post('/logout')}
                                className="w-full flex items-center gap-2 text-left px-4 py-2 text-xs text-rose-500 hover:text-rose-600 cursor-pointer"
                            >
                                <LogOut className="w-4 h-4" />
                                <span>Cerrar Sesión</span>
                            </button>
                        </div>
                    )}
                </div>
            </div>
        </header>
    );
}
