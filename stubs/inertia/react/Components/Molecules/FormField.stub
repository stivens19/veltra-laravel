import React from 'react';
import Input from '../Atoms/Input';

export default function FormField({ label, error, required = false, className = '', id, ...inputProps }) {
    return (
        <div className={`space-y-1.5 ${className}`}>
            {label && (
                <label htmlFor={id} className="block text-xs font-bold text-slate-700 dark:text-slate-300">
                    {label} {required && <span className="text-rose-500">*</span>}
                </label>
            )}
            <Input id={id} hasError={!!error} {...inputProps} />
            {error && (
                <p className="text-[11px] font-semibold text-rose-500 mt-1">{error}</p>
            )}
        </div>
    );
}
