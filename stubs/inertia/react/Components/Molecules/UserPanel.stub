import React from 'react';
import Avatar from '../Atoms/Avatar';

export default function UserPanel({ user = { name: 'Usuario', email: 'user@example.com' }, role = 'Administrator', className = '' }) {
    return (
        <div className={`vlt-sidebar-user flex items-center gap-3 p-3 rounded-2xl bg-slate-50 dark:bg-slate-800/50 border border-slate-200/60 dark:border-slate-700/60 ${className}`}>
            <Avatar name={user?.name} online={true} size="md" />
            <div className="user-info min-w-0 flex-1">
                <p className="user-name text-xs font-bold text-slate-900 dark:text-white truncate">
                    {user?.name}
                </p>
                <span className="user-role text-[10px] font-semibold text-cyan-600 dark:text-cyan-400 uppercase tracking-wider font-mono">
                    {role}
                </span>
            </div>
        </div>
    );
}
