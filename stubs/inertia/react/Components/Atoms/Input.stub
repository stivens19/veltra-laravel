import React from 'react';

export default function Input({ className = '', hasError = false, ...props }) {
    return (
        <input
            className={`w-full px-3.5 py-2 text-sm rounded-xl border bg-white dark:bg-slate-950 text-slate-900 dark:text-white placeholder:text-slate-400 focus:outline-none transition-colors ${
                hasError
                    ? 'border-rose-500 focus:border-rose-500 focus:ring-1 focus:ring-rose-500'
                    : 'border-slate-200 dark:border-slate-700 focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500'
            } ${className}`}
            {...props}
        />
    );
}
