<{{ layoutTag }}>
    <x-slot name="header">
        <section class="vlt-content-header">
            <div>
                <h1 class="vlt-page-title">{{ __('{{ pageTitle }}') }}</h1>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
                    {{ __('{{ pageSubtitle }}') }}
                </p>
            </div>
            <nav class="vlt-breadcrumb" aria-label="Breadcrumb">
                <ol class="flex items-center gap-2 text-xs">
                    <li><a href="{{ route('dashboard') }}" class="text-slate-500 hover:text-cyan-600 font-medium">{{ __('Home') }}</a></li>
                    <li><span class="text-slate-300 dark:text-slate-600">/</span></li>
                    <li class="active font-bold text-cyan-600">{{ __('{{ pageTitle }}') }}</li>
                </ol>
            </nav>
        </section>
    </x-slot>

    <div class="w-full space-y-6">
        <!-- KPI Metrics Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="vlt-card p-5 border border-slate-200/80 dark:border-slate-800 bg-white dark:bg-slate-900 rounded-2xl shadow-xs">
                <div class="flex items-center justify-between mb-3">
                    <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">{{ __('Total Revenue') }}</span>
                    <span class="w-8 h-8 rounded-xl bg-cyan-50 dark:bg-cyan-950/40 text-cyan-600 dark:text-cyan-400 flex items-center justify-center">
                        <i data-lucide="dollar-sign" class="w-4 h-4"></i>
                    </span>
                </div>
                <div class="text-2xl font-black text-slate-900 dark:text-white">$48,250</div>
                <p class="text-[11px] text-emerald-600 dark:text-emerald-400 font-semibold mt-1 flex items-center gap-1">
                    <i data-lucide="trending-up" class="w-3.5 h-3.5"></i>
                    <span>+12.4% {{ __('vs last month') }}</span>
                </p>
            </div>

            <div class="vlt-card p-5 border border-slate-200/80 dark:border-slate-800 bg-white dark:bg-slate-900 rounded-2xl shadow-xs">
                <div class="flex items-center justify-between mb-3">
                    <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">{{ __('Active Users') }}</span>
                    <span class="w-8 h-8 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 text-emerald-600 dark:text-emerald-400 flex items-center justify-center">
                        <i data-lucide="users" class="w-4 h-4"></i>
                    </span>
                </div>
                <div class="text-2xl font-black text-slate-900 dark:text-white">2,420</div>
                <p class="text-[11px] text-emerald-600 dark:text-emerald-400 font-semibold mt-1 flex items-center gap-1">
                    <i data-lucide="trending-up" class="w-3.5 h-3.5"></i>
                    <span>+8.1% {{ __('new accounts') }}</span>
                </p>
            </div>

            <div class="vlt-card p-5 border border-slate-200/80 dark:border-slate-800 bg-white dark:bg-slate-900 rounded-2xl shadow-xs">
                <div class="flex items-center justify-between mb-3">
                    <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">{{ __('Conversion Rate') }}</span>
                    <span class="w-8 h-8 rounded-xl bg-amber-50 dark:bg-amber-950/40 text-amber-600 dark:text-amber-400 flex items-center justify-center">
                        <i data-lucide="activity" class="w-4 h-4"></i>
                    </span>
                </div>
                <div class="text-2xl font-black text-slate-900 dark:text-white">4.85%</div>
                <p class="text-[11px] text-emerald-600 dark:text-emerald-400 font-semibold mt-1 flex items-center gap-1">
                    <i data-lucide="trending-up" class="w-3.5 h-3.5"></i>
                    <span>+1.2% {{ __('efficiency') }}</span>
                </p>
            </div>

            <div class="vlt-card p-5 border border-slate-200/80 dark:border-slate-800 bg-white dark:bg-slate-900 rounded-2xl shadow-xs">
                <div class="flex items-center justify-between mb-3">
                    <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">{{ __('Open Tickets') }}</span>
                    <span class="w-8 h-8 rounded-xl bg-rose-50 dark:bg-rose-950/40 text-rose-600 dark:text-rose-400 flex items-center justify-center">
                        <i data-lucide="alert-circle" class="w-4 h-4"></i>
                    </span>
                </div>
                <div class="text-2xl font-black text-slate-900 dark:text-white">14</div>
                <p class="text-[11px] text-slate-500 dark:text-slate-400 font-medium mt-1">
                    {{ __('5 high priority') }}
                </p>
            </div>
        </div>

        <!-- Analytics Chart Placeholder Card -->
        <div class="vlt-card p-6 border border-slate-200/80 dark:border-slate-800 bg-white dark:bg-slate-900 rounded-2xl shadow-xs">
            <div class="flex items-center justify-between pb-4 border-b border-slate-100 dark:border-slate-800">
                <div>
                    <h3 class="text-sm font-bold text-slate-900 dark:text-white">{{ __('Performance Overview') }}</h3>
                    <p class="text-xs text-slate-500 dark:text-slate-400">{{ __('Monthly metrics and key indicators') }}</p>
                </div>
                <span class="vlt-pill vlt-pill-cyan text-xs font-semibold">{{ __('Live Stream') }}</span>
            </div>
            <div class="h-64 flex items-center justify-center text-slate-400 dark:text-slate-600 border border-dashed border-slate-200 dark:border-slate-800 rounded-xl my-4 bg-slate-50/50 dark:bg-slate-800/20">
                <div class="text-center">
                    <i data-lucide="bar-chart-3" class="w-8 h-8 mx-auto mb-2 text-cyan-500/70"></i>
                    <p class="text-xs font-semibold">{{ __('Chart Area ready for Chart.js / ApexCharts') }}</p>
                </div>
            </div>
        </div>
    </div>
</{{ layoutTag }}>
