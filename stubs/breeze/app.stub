    <!-- Scripts Veltra -->
    <script src="{{ asset('vendor/veltra/js/veltra.umd.js') }}"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            if (typeof lucide !== 'undefined') {
                lucide.createIcons();
            }

            // Sincronización bidireccional entre el selector de Navbar y las vistas de apariencia
            document.addEventListener('click', function(e) {
                const btn = e.target.closest('[data-vlt-toggle="theme"]');
                if (!btn) return;
                setTimeout(() => {
                    const current = document.documentElement.getAttribute('data-theme') || (document.documentElement.classList.contains('dark') ? 'dark' : 'light');
                    try {
                        localStorage.setItem('veltra-theme', current);
                        localStorage.setItem('flux.appearance', current);
                    } catch (err) {}
                    if (window.Flux?.applyAppearance) {
                        try { window.Flux.applyAppearance(current); } catch(err) {}
                    }
                    window.dispatchEvent(new CustomEvent('veltra:theme:changed', { detail: { theme: current } }));
                }, 10);
            });
        });
    </script>
    @stack('scripts')
    @if(class_exists(\Flux\Flux::class))
        @fluxScripts
    @endif
</body>
</html>
