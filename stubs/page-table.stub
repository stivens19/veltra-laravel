<{{ layoutTag }}>
    <x-slot name="header">
        <section class="vlt-content-header">
            <div>
                <h1 class="vlt-page-title">{{ __('{{ pageTitle }}') }}</h1>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
                    {{ __('{{ pageSubtitle }}') }}
                </p>
            </div>
            <nav class="vlt-breadcrumb" aria-label="Breadcrumb">
                <ol class="flex items-center gap-2 text-xs">
                    <li><a href="{{ route('dashboard') }}" class="text-slate-500 hover:text-cyan-600 font-medium">{{ __('Home') }}</a></li>
                    <li><span class="text-slate-300 dark:text-slate-600">/</span></li>
                    <li class="active font-bold text-cyan-600">{{ __('{{ pageTitle }}') }}</li>
                </ol>
            </nav>
        </section>
    </x-slot>

    <div class="w-full space-y-4">
        <!-- Table Toolbar & Card -->
        <div class="vlt-card border border-slate-200/80 dark:border-slate-800 bg-white dark:bg-slate-900 rounded-2xl shadow-xs overflow-hidden">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 p-4 border-b border-slate-100 dark:border-slate-800">
                <div class="relative flex-1 max-w-sm">
                    <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute left-3 top-2.5 pointer-events-none"></i>
                    <input type="text" placeholder="{{ __('Search records...') }}"
                        class="w-full pl-9 pr-3 py-1.5 text-xs rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 focus:outline-none focus:border-cyan-500 text-slate-800 dark:text-slate-100 placeholder:text-slate-400" />
                </div>
                <div class="flex items-center gap-2">
                    <button type="button" class="px-3 py-1.5 text-xs font-semibold rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700/60 inline-flex items-center gap-1.5 transition-colors">
                        <i data-lucide="filter" class="w-3.5 h-3.5 text-slate-400"></i>
                        <span>{{ __('Filter') }}</span>
                    </button>
                    <button type="button" class="px-3.5 py-1.5 text-xs font-bold rounded-xl bg-cyan-500 hover:bg-cyan-600 text-white shadow-xs inline-flex items-center gap-1.5 transition-colors">
                        <i data-lucide="plus" class="w-3.5 h-3.5"></i>
                        <span>{{ __('New Record') }}</span>
                    </button>
                </div>
            </div>

            <!-- Responsive Table -->
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs text-slate-700 dark:text-slate-200">
                    <thead class="bg-slate-50/75 dark:bg-slate-800/50 text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 border-b border-slate-100 dark:border-slate-800">
                        <tr>
                            <th class="py-3 px-5"># ID</th>
                            <th class="py-3 px-5">{{ __('Title / Item') }}</th>
                            <th class="py-3 px-5">{{ __('Category') }}</th>
                            <th class="py-3 px-5">{{ __('Status') }}</th>
                            <th class="py-3 px-5">{{ __('Date') }}</th>
                            <th class="py-3 px-5 text-right">{{ __('Actions') }}</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                        <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/40 transition-colors">
                            <td class="py-3.5 px-5 font-mono text-[11px] font-bold text-cyan-600 dark:text-cyan-400">#001</td>
                            <td class="py-3.5 px-5 font-semibold text-slate-900 dark:text-white">Example Item Alpha</td>
                            <td class="py-3.5 px-5 text-slate-500 dark:text-slate-400">Billing</td>
                            <td class="py-3.5 px-5">
                                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-50 text-emerald-600 dark:bg-emerald-950/40 dark:text-emerald-400">
                                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                                    Active
                                </span>
                            </td>
                            <td class="py-3.5 px-5 text-slate-500 dark:text-slate-400">{{ date('M d, Y') }}</td>
                            <td class="py-3.5 px-5 text-right">
                                <button type="button" class="p-1 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-500 hover:text-cyan-600 transition-colors">
                                    <i data-lucide="more-horizontal" class="w-4 h-4"></i>
                                </button>
                            </td>
                        </tr>
                        <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/40 transition-colors">
                            <td class="py-3.5 px-5 font-mono text-[11px] font-bold text-cyan-600 dark:text-cyan-400">#002</td>
                            <td class="py-3.5 px-5 font-semibold text-slate-900 dark:text-white">Example Item Beta</td>
                            <td class="py-3.5 px-5 text-slate-500 dark:text-slate-400">Support</td>
                            <td class="py-3.5 px-5">
                                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-50 text-amber-600 dark:bg-amber-950/40 dark:text-amber-400">
                                    <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                                    Pending
                                </span>
                            </td>
                            <td class="py-3.5 px-5 text-slate-500 dark:text-slate-400">{{ date('M d, Y') }}</td>
                            <td class="py-3.5 px-5 text-right">
                                <button type="button" class="p-1 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-500 hover:text-cyan-600 transition-colors">
                                    <i data-lucide="more-horizontal" class="w-4 h-4"></i>
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Table Footer / Pagination -->
            <div class="flex items-center justify-between px-5 py-3 border-t border-slate-100 dark:border-slate-800 text-xs text-slate-500 dark:text-slate-400">
                <span>{{ __('Showing 1 to 2 of 2 entries') }}</span>
                <div class="flex items-center gap-1">
                    <button disabled class="px-2.5 py-1 rounded-lg border border-slate-200 dark:border-slate-700 opacity-50 cursor-not-allowed">Previous</button>
                    <button class="px-2.5 py-1 rounded-lg bg-cyan-500 text-white font-bold">1</button>
                    <button disabled class="px-2.5 py-1 rounded-lg border border-slate-200 dark:border-slate-700 opacity-50 cursor-not-allowed">Next</button>
                </div>
            </div>
        </div>
    </div>
</{{ layoutTag }}>
